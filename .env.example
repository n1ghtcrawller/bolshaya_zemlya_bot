# Telegram
BOT_TOKEN=000000:replace_me
BOT_DROP_PENDING_UPDATES=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bolshaya_zemlya
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache TTL (seconds)
ROLE_CACHE_TTL=1800

# n8n webhooks (заглушки, заполнить при готовности workflow)
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SALES_ASSISTANT=/webhook/sales-assistant
N8N_WEBHOOK_EXPO_ASSISTANT=/webhook/expo-assistant
N8N_WEBHOOK_BROADCAST=/webhook/broadcast
N8N_WEBHOOK_CONTENT_PUBLISH=/webhook/content-publish
N8N_REQUEST_TIMEOUT=30
# Опционально. Если задан — целиком кладётся в HTTP-заголовок Authorization
# в каждый webhook-вызов. Примеры:
#   N8N_AUTH_HEADER=Bearer my-secret-token         (Header Auth с именем Authorization)
#   N8N_AUTH_HEADER=Basic dXNlcjpwYXNz             (Basic Auth, base64 от user:pass)
# На стороне n8n: открыть Webhook-ноду → Authentication → Header Auth / Basic Auth.
N8N_AUTH_HEADER=

# Bitrix24 (сбор лидов через входящий вебхук, crm.lead.add)
# Включить отправку лидов в Bitrix. Если false — строки в очередь не пишутся.
BITRIX_ENABLED=false
# Полный URL входящего вебхука до кода (без имени метода), напр.
#   https://your-portal.bitrix24.ru/rest/1/abcdef1234567890/
# Создать: CRM → Разработчикам → Другое → Входящий вебхук, право доступа "crm".
BITRIX_WEBHOOK_URL=
# SOURCE_ID лида в Bitrix (по умолчанию WEB)
BITRIX_SOURCE_ID=WEB
# ID ответственных менеджеров через запятую — round-robin распределение «по очереди».
# Пусто → ответственным становится владелец вебхука. Пример: 25,23,19,21
BITRIX_ASSIGNED_BY_IDS=
# Префикс заголовка лида
BITRIX_TITLE_PREFIX=Telegram-бот
# Код пользовательского поля лида для типа обращения, напр. UF_CRM_1700000000 (опц.)
BITRIX_UF_LEAD_TYPE_FIELD=
BITRIX_REQUEST_TIMEOUT=30
# Период тика воркера-диспетчера очереди (секунды)
BITRIX_DISPATCH_INTERVAL_SECONDS=60
# Максимум попыток доставки до пометки failed
BITRIX_MAX_ATTEMPTS=10
# База экспоненциального backoff между ретраями (секунды)
BITRIX_RETRY_BACKOFF_BASE_SECONDS=60

# Content publisher (cron внутри бота)
PUBLISHER_ENABLED=true
PUBLISHER_INTERVAL_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
